# docker/.env.example — template for the self-hosted stack.
#
# Copy to docker/.env (gitignored, NEVER commit) and fill in real values:
#   cp docker/.env.example docker/.env
# Load with: docker compose --env-file docker/.env -f docker/docker-compose.yaml up -d
#
# The compose file references only ${VAR} — no secrets live in it. All secrets
# live here. Generate strong random values, don't reuse the placeholders.

# --- Encryption (app-level secret encryption) ---
# openssl rand -hex 32
ENCRYPTION_KEY=CHANGEME_hex32
ENCRYPTION_SALT=CHANGEME_hex32

# --- Postgres (external / managed, e.g. RDS) ---
# Daytona needs its OWN database — it runs TypeORM migrations on boot
# (RUN_MIGRATIONS=true). Sharing a Postgres *instance* is fine; sharing a
# *database* with another app is not. Create it first:
#   CREATE DATABASE daytona;
#   CREATE USER daytona WITH PASSWORD '...';
#   GRANT ALL PRIVILEGES ON DATABASE daytona TO daytona;
DB_HOST=CHANGEME.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USERNAME=daytona
DB_PASSWORD=CHANGEME
DB_DATABASE=daytona

# TLS to Postgres. Keep both true for RDS.
# The api pins verification to Amazon's RDS CA via NODE_EXTRA_CA_CERTS; the
# bundle is mounted from docker/certs/rds-ca-bundle.pem. Download it once:
#   mkdir -p docker/certs && curl -fsSL \
#     https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem \
#     -o docker/certs/rds-ca-bundle.pem
# Non-RDS Postgres without TLS: set DB_TLS_ENABLED=false.
# Never set DB_TLS_REJECT_UNAUTHORIZED=false in production — it accepts any cert
# and defeats the point of TLS.
DB_TLS_ENABLED=true
DB_TLS_REJECT_UNAUTHORIZED=true

# --- Redis (external / managed, e.g. ElastiCache) ---
# ⚠ Cluster mode is NOT supported. The Go proxy uses go-redis *redis.Client
# (standalone, see libs/common-go/pkg/cache/redis_cache.go) and the api uses
# BullMQ, which needs hash-tag work to run on a cluster. Use a cluster-mode
# DISABLED instance (or its single primary endpoint).
#
# ⚠ Daytona always uses logical DB 0 — there is no REDIS_DB setting. It writes
# runner:jobs:*, sandbox:activity and BullMQ queues there. Prefer a dedicated
# instance; a FLUSHDB from a co-tenant app would drop Daytona's job queues.
REDIS_HOST=CHANGEME.xxxxxx.ng.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=CHANGEME_or_empty
# ElastiCache in-transit encryption. Its certs chain to a publicly trusted
# Amazon CA, so no extra CA bundle is needed here (unlike RDS).
REDIS_TLS=true

# --- Internal container registry (self-hosted registry:6000) ---
# Transient store for sandbox snapshots created at runtime. Separate concern
# from ECR, which holds the platform images — both are needed.
REGISTRY_ADMIN=admin
REGISTRY_PASSWORD=CHANGEME

# --- MinIO / S3 object storage ---
MINIO_ROOT_USER=daytona
MINIO_ROOT_PASSWORD=CHANGEME

# --- Service API keys / tokens (openssl rand -hex 32 each; must match across services) ---
PROXY_API_KEY=CHANGEME
DAYTONA_RUNNER_TOKEN=CHANGEME
SSH_GATEWAY_API_KEY=CHANGEME
OTEL_COLLECTOR_API_KEY=CHANGEME
HEALTH_CHECK_API_KEY=CHANGEME

# --- SMTP (optional) ---
# Leave SMTP_HOST empty to disable email. The ONLY email Daytona sends is the
# organization invitation (apps/api/src/email/services/email.service.ts) — with
# it empty, invitations are still created, you just hand over the link yourself.
# Signup needs no email: SKIP_USER_EMAIL_VERIFICATION=true in the compose file.
# To enable, point at a relay (e.g. email-smtp.us-east-1.amazonaws.com / SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_EMAIL_FROM=Daytona Team <no-reply@ideaboxai.com>

# --- SSH gateway keypair + host key (base64-encoded) ---
# Generate:
#   ssh-keygen -t rsa -b 4096 -N '' -f gw && base64 -w0 gw.pub  # -> SSH_GATEWAY_PUBLIC_KEY
#   base64 -w0 gw                                               # -> SSH_PRIVATE_KEY
#   ssh-keygen -t rsa -b 4096 -N '' -f host && base64 -w0 host  # -> SSH_HOST_KEY
SSH_GATEWAY_PUBLIC_KEY=CHANGEME_base64
SSH_PRIVATE_KEY=CHANGEME_base64
SSH_HOST_KEY=CHANGEME_base64

# --- Public host of the SSH gateway (EC2 public IP or DNS) ---
SSH_GATEWAY_HOST=1.2.3.4

# --- Fork image registry (only needed with docker-compose.registry.override.yaml) ---
# FORK_REGISTRY must include the ECR namespace path, not just the host —
# build-push.sh appends /daytona-<svc>, so this must resolve to the real repos.
# FORK_REGISTRY=120354378950.dkr.ecr.us-east-1.amazonaws.com/ideaboxai-platform-core
# FORK_TAG=fork-YYYYMMDD-<shortsha>
